# ---- Spotify OAuth (required) -------------------------------------------
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_SCOPE=user-top-read user-read-private

# ---- Sessions ------------------------------------------------------------
# Signs login tokens and OAuth state. Required in production; a dev key is
# auto-generated into backend/.secret_key when unset.
FLASK_SECRET_KEY=
SESSION_TTL_SECONDS=2592000

# ---- Database ------------------------------------------------------------
# Defaults to sqlite in backend/spotty.db. Postgres example:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/trill
DATABASE_URL=

# ---- Frontend + CORS -----------------------------------------------------
FRONTEND_URL=http://localhost:5180   # https://trill.ai in production
# Comma separated. Defaults to FRONTEND_URL.
CORS_ALLOW_ORIGINS=

# ---- ACE-Step 1.5 (local GPU server) -------------------------------------
ACESTEP_API_URL=http://127.0.0.1:8001
DEFAULT_DURATION_SECONDS=60
MAX_DURATION_SECONDS=240
MAX_VARIATIONS=3
ACESTEP_INFER_STEPS=8
AUDIO_OUTPUT_DIR=

# ---- Claude composer (optional, strongly recommended) --------------------
# With a key, Claude writes the style caption, lyrics, title and the Sound DNA
# narrative. Without one, trill uses the built-in template engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_ENABLED=true

# ---- Genre tags ------------------------------------------------------------
LASTFM_API_KEY=

# ---- Background completion worker ------------------------------------------
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=3

# ---- Rate limits -------------------------------------------------------------
RATE_LIMIT_GENERATE=12 per minute
RATE_LIMIT_LLM=20 per minute
RATE_LIMIT_DEFAULT=240 per minute

# ---- Misc --------------------------------------------------------------------
APP_ENV=development
TESSERACT_CMD=
MAX_UPLOAD_MB=8
